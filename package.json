{
  "name": "rag-chatbot",
  "version": "1.0.0",
  "description": "Full-stack RAG Chatbot with React, tRPC, and SQLite",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node dist/index.js",
    "dev:frontend": "vite --port 5173",
    "dev:all": "npm run build:server && concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"node dist/index.js\" \"vite --port 5173\"",
    "build": "vite build",
    "build:server": "esbuild server/_core/index.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js --external:better-sqlite3 --external:dotenv --external:pdf-parse",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "*",
    "@radix-ui/react-alert-dialog": "*",
    "@radix-ui/react-avatar": "*",
    "@radix-ui/react-checkbox": "*",
    "@radix-ui/react-context-menu": "*",
    "@radix-ui/react-dialog": "*",
    "@radix-ui/react-dropdown-menu": "*",
    "@radix-ui/react-hover-card": "*",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-menubar": "*",
    "@radix-ui/react-navigation-menu": "*",
    "@radix-ui/react-popover": "*",
    "@radix-ui/react-progress": "*",
    "@radix-ui/react-radio-group": "*",
    "@radix-ui/react-scroll-area": "*",
    "@radix-ui/react-select": "*",
    "@radix-ui/react-separator": "*",
    "@radix-ui/react-slider": "*",
    "@radix-ui/react-slot": "*",
    "@radix-ui/react-switch": "*",
    "@radix-ui/react-tabs": "*",
    "@radix-ui/react-toast": "*",
    "@radix-ui/react-toggle": "*",
    "@radix-ui/react-toggle-group": "*",
    "@radix-ui/react-tooltip": "*",
    "@tanstack/react-query": "^5.28.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "autoprefixer": "^10.4.17",
    "axios": "^1.6.7",
    "better-sqlite3": "^11.5.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "date-fns": "^3.3.1",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.31.3",
    "express": "^4.18.2",
    "framer-motion": "^10.16.4",
    "jose": "^5.4.1",
    "lucide-react": "^0.383.0",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.2.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pdf-parse": "*",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "vite": "^5.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "rag",
    "chatbot",
    "trpc",
    "react",
    "generative-ai"
  ],
  "author": "",
  "license": "MIT"
}
